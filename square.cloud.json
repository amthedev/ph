{
  "name": "live-stream",
  "description": "Sistema de live streaming com verificação de espectadores",
  "main": "backend.py",
  "version": "1.0.0",
  "keywords": ["live", "streaming", "flask", "python", "web"],
  "author": "Live Stream Team",
  "license": "MIT",
  "start": "python backend.py",
  "build": {
    "start": "pip install -r requirements.txt && python backend.py"
  },
  "env": {
    "PYTHON_VERSION": "3.9",
    "FLASK_ENV": "production",
    "DATABASE_URL": "sqlite:///live_stream.db",
    "SECRET_KEY": "your-secret-key-here",
    "ADMIN_PASSWORD": "admin123"
  },
  "domains": {
    "primary": "live-stream.squareweb.app"
  },
  "port": 80,
  "routes": [
    {
      "src": "/",
      "dest": "/"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": {
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type, Authorization"
  },
  "engines": {
    "python": ">=3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/live-stream.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/live-stream/issues"
  },
  "homepage": "https://github.com/yourusername/live-stream#readme"
}
